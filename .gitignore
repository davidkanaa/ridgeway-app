.venv/
env/
venv/
ENV/

# Python compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Application Secrets & Configuration (CRITICAL FOR SECURITY)
# ==============================================================================
# Never commit credentials, API keys, or database passwords
.env
.env.*
!.env.example
secrets.json

